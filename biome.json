{
	"$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended"
		}
	},
	"files": {
		"includes": [
			"**",
			"!**/node_modules",
			"!**/dist",
			"!docs",
			"!pnpm-lock.yaml"
		]
	}
}
